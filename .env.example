# ai-bridge 环境变量示例
#
# 使用方法:
#   cp .env.example .env   # 然后按需修改 .env，cargo run 即可
#
# 加载行为:
#   - 启动时自动读取 `.env`（优先 Cargo manifest 目录，部署时回退到
#     可执行文件所在目录；两处都没有则静默跳过）。
#   - 已导出的环境变量优先于 `.env` 中的同名项，`.env` 不会覆盖它们。

# ===================== 必填: 上游配置 =====================

# 上游 API 格式，三者选一:
#   anthropic-messages | oai-chat | oai-responses
# 由它显式决定认证头、格式转换与错误格式，不做 URL 启发式猜测 (ADR-0002)。
UPSTREAM_TYPE=oai-chat

# 上游 API 地址（按 UPSTREAM_TYPE 匹配的 endpoint）
UPSTREAM_URL=https://api.example.com/v1/chat/completions

# 上游 API 密钥（openai 上游走 Authorization: Bearer；anthropic 上游走 x-api-key）
UPSTREAM_API_KEY=sk-your-upstream-key

# ===================== 可选: 上游 =====================

# 强制使用的模型名 —— 本地入口请求体里的 model 一律被覆盖为此值 (AGENTS.md)。
# 默认: deepseek-v4-flash
UPSTREAM_MODEL=deepseek-v4-flash

# 额外的上游请求头，格式 `A:a|B:b`：竖线分隔、每个值在第一个冒号处拆分、可含冒号。
# 覆盖同名的默认头；重复名后者生效。
UPSTREAM_HEADERS=X-Tenant:default|X-Tag:foo

# 入站鉴权 token —— 校验本地客户端访问中转的 token（与上游自身的认证分离）。
# 留空/不设置 = 本地入口不做鉴权。
# 注意: 请注释掉这一行而非设成空串；空串会被当作一个“必须匹配的空 token”，
#       行为与“不鉴权”并不等价。
#UPSTREAM_AUTH_KEY=local-token

# ===================== 可选: 监听 =====================

# 监听地址与端口
# 默认: 0.0.0.0:18650
LISTEN_ADDR=0.0.0.0
LISTEN_PORT=18650

# ===================== 可选: 视觉模型 (图片转文字) =====================

# 第三方 vision 补充功能的开关, 默认关闭 (off)。
# 关闭(默认): 图片原样透传给上游, 由上游自身的 vision 处理。
# 开启 (1/true/yes/on): 对已确认的纯文本上游模型执行下方 VISION_* 描述/占位逻辑。
#THIRDPARTY_VISION_SUPPLEMENT=1

# 当 THIRDPARTY_VISION_SUPPLEMENT 开启、本地请求携带图片、而上游是已确认的
# 纯文本模型时，用视觉模型把图片描述成文字、替换图片块后再转发 (ADR-0004)。
# 注意: VISION_URL / VISION_API_KEY / VISION_MODEL 三项必须同时存在才启用；
#       缺任一项则整体关闭，退化为 [Unsupported Image] 占位符。
# 视觉 endpoint 的格式会从 URL 判断: 含 /responses → oai-responses；
#       含 /messages → anthropic-messages；否则视为 oai-chat。
VISION_URL=
VISION_API_KEY=
VISION_MODEL=

# 视觉请求的额外头，格式同 UPSTREAM_HEADERS。
VISION_HEADERS=

# 描述提示词模板: auto(默认; 视觉模型自行判断 UI 截图/通用图) | general | ui | compact。
# 未知值回退到 auto。
VISION_PROMPT_MODE=auto

# 自定义描述提示词(可选)。设置后完全覆盖 VISION_PROMPT_MODE 的模板;
# 多图请求会为每张图注入 [Image N] 标签, 建议在自定义提示词中说明使用该标签。
#VISION_PROMPT=

# 描述输出的 token 上限(可选)。留空 / 0 / 非法值 = 不设置。
#VISION_MAX_TOKENS=1024

# ===================== 可选: 日志 =====================

# tracing 日志过滤，默认 info。例如: debug / ai_bridge=trace / warn
RUST_LOG=info

# ===================== 已废弃 (出现即报错) =====================

# 旧命名 OPENAI_COMP_URL / OPENAI_COMP_API_KEY / OPENAI_COMP_MODEL /
# OPENAI_COMP_AUTH_KEY / OPENAI_COMP_HEADERS 已移除 (ADR-0003)，
# 进程一旦检测到会直接报配置错误，请改用上面的 UPSTREAM_* 变量。
